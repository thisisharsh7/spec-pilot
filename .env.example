# SpecPilot — environment template.
#
# Copy to .env.local and fill in. Placeholders only; never commit real values.
# .env.local is gitignored; this file is the only env file that is committed.

# ─── Supabase (required for any deployed environment) ────────────────────────
# Project URL. Browser-visible by design.
NEXT_PUBLIC_SUPABASE_URL=

# SERVER-ONLY. Bypasses row-level security, so it must never be prefixed with
# NEXT_PUBLIC_ and must never be imported into a client component. It is read
# only by lib/data/supabase-admin.ts, which is marked `import "server-only"` so
# the build fails if that ever changes.
#
# There is deliberately no anon key: every read and write is server-side, and the
# model_snapshots table has RLS enabled with no anonymous policy at all.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Bright Data (required to refresh the catalog) ───────────────────────────
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_.
# Account Settings -> API Tokens at brightdata.com/cp/setting
BRIGHT_DATA_API_TOKEN=

# Scraper Studio collector ID. Always begins with "c_".
BRIGHT_DATA_OPENAI_COLLECTOR_ID=

# Not implemented. Anthropic is labelled "Coming soon" until a real collector
# runs against its documentation. Leave empty.
BRIGHT_DATA_ANTHROPIC_COLLECTOR_ID=

# ─── Admin ───────────────────────────────────────────────────────────────────
# Guards POST /api/providers/[provider]/refresh, compared in constant time.
# Any long random string, e.g. `openssl rand -hex 32`. Without it the endpoint
# refuses to run rather than accepting unauthenticated requests.
ADMIN_REFRESH_SECRET=

# ─── Development only ────────────────────────────────────────────────────────
# Serve typed, hand-transcribed fixtures instead of real collector output. Only
# ever a local convenience: the UI shows a "Development data" badge whenever this
# is the active source.
ENABLE_DEVELOPMENT_FIXTURES=true

# Second, deliberate opt-in required before fixtures may be served when
# NODE_ENV=production. Leave unset. Its only purpose is to make a
# fixture-backed deployment impossible by accident.
ALLOW_FIXTURES_IN_PRODUCTION=

# Override the local snapshot directory (default: .data/snapshots). Used by the
# test suite to exercise both the snapshot-present and snapshot-absent paths.
# Filesystem snapshots are disabled entirely when NODE_ENV=production.
SPECPILOT_SNAPSHOT_DIR=
